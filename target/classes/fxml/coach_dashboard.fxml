<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1020" prefHeight="680"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.coaching.controller.CoachDashboardController">

    <top>
        <VBox spacing="8" style="-fx-background-color: #1e272e; -fx-padding: 14;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="lblBienvenue" text="Espace Coach" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Déconnexion" onAction="#handleDeconnexion" style="-fx-background-color: #c0392b; -fx-text-fill: white;"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Sportif :" style="-fx-text-fill: #d2dae2;"/>
                <ComboBox fx:id="cmbSportifs" prefWidth="230"/>
                <Button text="Analyser progression" onAction="#handleAnalyserSportif"/>
                <Button text="Exporter bilan CSV" onAction="#handleExportSportifCSV"/>
                <Label fx:id="lblStatSportif" style="-fx-text-fill: #0be881; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="12" style="-fx-padding: 14;">
            <Label text="1. Programmes d'entraînement" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            <HBox spacing="8">
                <TextField fx:id="txtProgTitre" promptText="Titre du programme" prefWidth="200"/>
                <TextField fx:id="txtProgDesc" promptText="Description" prefWidth="240"/>
                <ComboBox fx:id="cmbProgNiveau" prefWidth="140"/>
                <TextField fx:id="txtProgDuree" promptText="Semaines" prefWidth="90"/>
                <Button text="Créer Programme" onAction="#handleCreerProgramme" style="-fx-background-color: #2980b9; -fx-text-fill: white;"/>
                <Button text="Supprimer" onAction="#handleSupprimerProgramme" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
            </HBox>

            <TableView fx:id="tableProgrammes" prefHeight="200">
                <columns>
                    <TableColumn fx:id="colProgTitre" text="Titre" prefWidth="240"/>
                    <TableColumn fx:id="colProgNiveau" text="Niveau" prefWidth="140"/>
                    <TableColumn fx:id="colProgDuree" text="Durée (sem.)" prefWidth="120"/>
                    <TableColumn fx:id="colProgDesc" text="Description" prefWidth="460"/>
                </columns>
            </TableView>

            <Label text="2. Séances du programme sélectionné" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            <HBox spacing="8">
                <TextField fx:id="txtSeanceTitre" promptText="Titre de la séance" prefWidth="230"/>
                <ComboBox fx:id="cmbSeanceJour" prefWidth="130"/>
                <TextField fx:id="txtSeanceDuree" promptText="Durée (min)" prefWidth="110"/>
                <TextField fx:id="txtSeanceCalories" promptText="Calories est." prefWidth="110"/>
                <Button text="Ajouter Séance" onAction="#handleAjouterSeance" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
                <Button text="Supprimer Séance" onAction="#handleSupprimerSeance" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
            </HBox>

            <TableView fx:id="tableSeances" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colSeanceTitre" text="Séance" prefWidth="280"/>
                    <TableColumn fx:id="colSeanceJour" text="Jour" prefWidth="140"/>
                    <TableColumn fx:id="colSeanceDuree" text="Durée (min)" prefWidth="130"/>
                    <TableColumn fx:id="colSeanceCal" text="Calories" prefWidth="130"/>
                    <TableColumn fx:id="colSeanceStatut" text="Statut" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>