<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" alignment="CENTER" prefWidth="420" prefHeight="320"
      style="-fx-background-color: #f4f6f9;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.coaching.controller.LoginController">
    <padding>
        <Insets top="28" right="32" bottom="28" left="32"/>
    </padding>

    <Label text="Coaching Sportif Personnalisé" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
    <Label text="Connectez-vous à votre espace Coach ou Sportif" style="-fx-text-fill: #7f8c8d;"/>

    <TextField fx:id="txtEmail" promptText="E-mail (ex: coach@fit.ma ou youssef@fit.ma)"/>
    <PasswordField fx:id="txtPassword" promptText="Mot de passe (123456)"/>

    <Button text="Se connecter" onAction="#handleLogin" maxWidth="Infinity"
            style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8;"/>

    <Label fx:id="lblErreur" style="-fx-text-fill: #c0392b; -fx-font-weight: bold;" wrapText="true"/>
</VBox>