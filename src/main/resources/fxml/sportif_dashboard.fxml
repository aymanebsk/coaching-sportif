<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1020" prefHeight="680"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.coaching.controller.SportifDashboardController">

    <top>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 14;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="lblBienvenue" text="Espace Sportif" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Exporter CSV" onAction="#handleExportCSV"/>
                <Button text="Déconnexion" onAction="#handleDeconnexion" style="-fx-background-color: #c0392b; -fx-text-fill: white;"/>
            </HBox>
            <HBox spacing="24">
                <Label text="IMC actuel :" style="-fx-text-fill: #bdc3c7;"/>
                <Label fx:id="lblImc" text="-" style="-fx-text-fill: #2ecc71; -fx-font-weight: bold;"/>
                <Label text="Objectif calorique :" style="-fx-text-fill: #bdc3c7;"/>
                <Label fx:id="lblCaloriesCible" text="-" style="-fx-text-fill: #f1c40f; -fx-font-weight: bold;"/>
                <Label text="Consommé aujourd'hui :" style="-fx-text-fill: #bdc3c7;"/>
                <Label fx:id="lblCaloriesAujourdhui" text="-" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                <Label text="Séances réalisées :" style="-fx-text-fill: #bdc3c7;"/>
                <Label fx:id="lblCompletion" text="-" style="-fx-text-fill: #3498db; -fx-font-weight: bold;"/>
            </HBox>
            <Label fx:id="lblAlerteStagnation" style="-fx-text-fill: #ff7675; -fx-font-weight: bold;" visible="false"/>
        </VBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="Mes Séances">
                <VBox spacing="10" style="-fx-padding: 14;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Filtrer par statut :"/>
                        <ComboBox fx:id="cmbFiltreStatut" onAction="#appliquerFiltreSeances"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Marquer la séance sélectionnée comme TERMINÉE" onAction="#handleValiderSeance"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    </HBox>
                    <TableView fx:id="tableSeances" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colSeanceTitre" text="Séance" prefWidth="280"/>
                            <TableColumn fx:id="colSeanceJour" text="Jour" prefWidth="140"/>
                            <TableColumn fx:id="colSeanceDuree" text="Durée (min)" prefWidth="130"/>
                            <TableColumn fx:id="colSeanceCalories" text="Calories est." prefWidth="140"/>
                            <TableColumn fx:id="colSeanceStatut" text="Statut" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <Tab text="Progression &amp; Courbe">
                <VBox spacing="10" style="-fx-padding: 14;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="txtPoids" promptText="Poids (kg) ex: 83.5" prefWidth="140"/>
                        <TextField fx:id="txtTourTaille" promptText="Tour taille (cm)" prefWidth="140"/>
                        <TextField fx:id="txtCommentaire" promptText="Commentaire" prefWidth="260"/>
                        <Button text="Enregistrer mesure" onAction="#handleAjouterMesure"
                                style="-fx-background-color: #2980b9; -fx-text-fill: white;"/>
                    </HBox>
                    <LineChart fx:id="chartPoids" title="Évolution du poids" VBox.vgrow="ALWAYS">
                        <xAxis><CategoryAxis label="Date"/></xAxis>
                        <yAxis><NumberAxis label="Poids (kg)" forceZeroInRange="false"/></yAxis>
                    </LineChart>
                </VBox>
            </Tab>

            <Tab text="Suivi Nutrition">
                <VBox spacing="10" style="-fx-padding: 14;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <ComboBox fx:id="cmbTypeRepas"/>
                        <TextField fx:id="txtRepasCalories" promptText="Calories (kcal)" prefWidth="140"/>
                        <TextField fx:id="txtRepasProteines" promptText="Protéines (g)" prefWidth="140"/>
                        <Button text="Ajouter repas" onAction="#handleAjouterRepas"
                                style="-fx-background-color: #2980b9; -fx-text-fill: white;"/>
                    </HBox>
                    <TableView fx:id="tableNutrition" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colRepasDate" text="Date" prefWidth="180"/>
                            <TableColumn fx:id="colRepasType" text="Repas" prefWidth="220"/>
                            <TableColumn fx:id="colRepasCal" text="Calories (kcal)" prefWidth="180"/>
                            <TableColumn fx:id="colRepasProt" text="Protéines (g)" prefWidth="180"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>